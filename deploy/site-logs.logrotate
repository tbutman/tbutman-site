# Installed as /etc/logrotate.d/tbutman-site. Both sites' logs: tbutman.com's and taptilde.com's. The raw log (with full IP addresses) is kept for
# four weeks; the stats report keeps its own anonymized totals beyond that. copytruncate leaves
# nginx writing to the same open file, so it needs no signal.
/var/log/tbutman-site/access.log /var/log/tbutman-site/taptilde.log {
  weekly
  rotate 4
  compress
  delaycompress
  missingok
  notifempty
  copytruncate
}
